# =============================================================================
#  Personal AI Agent Platform — Environment Variables Template
#  Copy this file to .env and fill in every value before starting services.
#  NEVER commit .env to version control.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  Application
# ─────────────────────────────────────────────────────────────────────────────

# Secret key for JWT signing and session encryption — must be long and random.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=CHANGE_ME_generate_a_secure_random_string_here

# Public-facing URL of the application (no trailing slash)
APP_URL=https://yourdomain.com


# ─────────────────────────────────────────────────────────────────────────────
#  PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentdb
POSTGRES_USER=agentuser
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password

# Full DSN consumed by SQLAlchemy / asyncpg
DATABASE_URL=postgresql+asyncpg://agentuser:CHANGE_ME_strong_postgres_password@postgres:5432/agentdb


# ─────────────────────────────────────────────────────────────────────────────
#  Redis
# ─────────────────────────────────────────────────────────────────────────────

REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# Full URL consumed by the app and Celery
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/0


# ─────────────────────────────────────────────────────────────────────────────
#  AI Provider
# ─────────────────────────────────────────────────────────────────────────────

# Which AI provider to use: anthropic | openai | ollama
AI_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4 / o-series)
OPENAI_API_KEY=sk-...

# Ollama (local — set AI_PROVIDER=ollama and point to your Ollama host)
OLLAMA_HOST=http://host.docker.internal:11434

# Model to use for the main agent (must be compatible with the chosen provider)
# Examples: claude-sonnet-4-5 | gpt-4o | gpt-4o-mini | llama3.3
AI_MODEL=claude-sonnet-4-5

# Suppress verbose model/provider logging in production
HERMES_QUIET_MODE=true


# ─────────────────────────────────────────────────────────────────────────────
#  Google OAuth (for Gmail / Calendar integrations)
# ─────────────────────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/oauth/google/callback

# Fernet key used to encrypt stored OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=CHANGE_ME_generate_fernet_key_here


# ─────────────────────────────────────────────────────────────────────────────
#  Email Polling
# ─────────────────────────────────────────────────────────────────────────────

# How often (in minutes) the worker polls connected mailboxes
EMAIL_POLL_INTERVAL_MINUTES=15


# ─────────────────────────────────────────────────────────────────────────────
#  Speech-to-Text (STT)
# ─────────────────────────────────────────────────────────────────────────────

# browser  — uses the Web Speech API in the client (no server cost)
# whisper  — transcribes server-side via OpenAI Whisper API
STT_PROVIDER=browser

# Required when STT_PROVIDER=whisper
OPENAI_WHISPER_API_KEY=sk-...


# ─────────────────────────────────────────────────────────────────────────────
#  Text-to-Speech (TTS)
# ─────────────────────────────────────────────────────────────────────────────

# browser    — uses the Web Speech Synthesis API (no cost)
# openai     — uses OpenAI TTS API
# elevenlabs — uses ElevenLabs streaming TTS
TTS_PROVIDER=browser

# ElevenLabs
ELEVENLABS_API_KEY=...

# OpenAI TTS (can reuse OPENAI_API_KEY, or use a restricted key)
OPENAI_TTS_API_KEY=sk-...

# Voice ID / name — interpretation depends on the chosen TTS_PROVIDER
# Examples: alloy | echo | fable | onyx | nova | shimmer  (OpenAI)
#           21m00Tcm4TlvDq8ikWAM                         (ElevenLabs voice ID)
TTS_VOICE=alloy

# Playback speed multiplier (0.25 – 4.0 for OpenAI)
TTS_SPEED=1.0


# ─────────────────────────────────────────────────────────────────────────────
#  General
# ─────────────────────────────────────────────────────────────────────────────

# IANA timezone for scheduling and display (e.g. America/New_York, Europe/London)
TIMEZONE=UTC

# Python / uvicorn log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ─────────────────────────────────────────────────────────────────────────────
#  Backup (optional — leave blank to store backups locally only)
# ─────────────────────────────────────────────────────────────────────────────

# S3-compatible bucket name
BACKUP_S3_BUCKET=

# AWS / MinIO access credentials for backup uploads
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# AWS region (us-east-1, eu-west-1, …)
BACKUP_S3_REGION=us-east-1

# Optional: custom endpoint for S3-compatible stores (MinIO, Backblaze, etc.)
# BACKUP_S3_ENDPOINT=https://s3.example.com


# ─────────────────────────────────────────────────────────────────────────────
#  Security / Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────

# Maximum file upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# API requests allowed per user per minute
RATE_LIMIT_PER_MINUTE=60

# How long a logged-in session lasts (hours)
SESSION_EXPIRE_HOURS=24


# ─────────────────────────────────────────────────────────────────────────────
#  Caddy / TLS
# ─────────────────────────────────────────────────────────────────────────────

# Your public domain name — no protocol, no trailing slash (e.g. agent.example.com)
DOMAIN=yourdomain.com

# Email address for Let's Encrypt certificate notifications
CADDY_EMAIL=admin@yourdomain.com
