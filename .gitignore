# =============================================================================
#  Personal AI Agent Platform — .gitignore
# =============================================================================

# ─── Environment & secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
# lib/
lib64/
!frontend/lib/
MANIFEST
.Python
develop-eggs/

# Virtual environments
.venv/
venv/
env/
ENV/
.env/
.venv*/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.tox/
.nox/
nosetests.xml
test-results/
junit.xml

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Linting
.ruff_cache/

# Profiling
*.prof

# ─── Node / Next.js ──────────────────────────────────────────────────────────
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

.next/
.nuxt/
out/
dist/
.output/
*.tsbuildinfo
next-env.d.ts

# ─── Docker ──────────────────────────────────────────────────────────────────
# Local Docker volumes (if bind-mounted into the repo)
docker-volumes/
caddy_data/
caddy_config/
postgres_data/
redis_data/

# ─── Database ────────────────────────────────────────────────────────────────
*.sqlite3
*.sqlite
*.db
*.sql.gz
backups/

# Alembic
alembic/versions/*.pyc

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# ─── OS artefacts ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
log/

# ─── Build / CI artefacts ────────────────────────────────────────────────────
*.tar.gz
*.zip
*.tgz
.cache/
tmp/
temp/

# ─── Caddy TLS data (never commit) ───────────────────────────────────────────
deployment/caddy/data/
deployment/caddy/config/

# ─── Misc ────────────────────────────────────────────────────────────────────
.hypothesis/
site/
docs/_build/
.sass-cache/
*.css.map
*.js.map
