# ─────────────────────────────────────────────────────────────────────────────
#  Caddyfile — Reverse proxy for the Personal AI Agent Platform
#  Uses environment variable {$DOMAIN} for the site address.
#  Auto-HTTPS via Let's Encrypt (ACME HTTP-01 challenge).
# ─────────────────────────────────────────────────────────────────────────────

{
    # Global options
    email {$CADDY_EMAIL}

    # Enable HTTP/3
    servers {
        protocols h1 h2 h3
    }

    # Prefer ACME over ZeroSSL
    acme_ca https://acme-v02.api.letsencrypt.org/directory

    # Optional: enable admin API only on loopback
    admin localhost:2019
}

# ─── Redirect bare HTTP → HTTPS ──────────────────────────────────────────────
http://{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

# ─── Main site ───────────────────────────────────────────────────────────────
{$DOMAIN} {

    # ── TLS (Let's Encrypt auto-provisioned) ──────────────────
    tls {$CADDY_EMAIL}

    # ── Logging ───────────────────────────────────────────────
    log {
        output stdout
        format json
        level INFO
    }

    # ── Compression ───────────────────────────────────────────
    encode {
        gzip 6
        zstd
    }

    # ── Security headers ──────────────────────────────────────
    header {
        # Enable HSTS (1 year, include sub-domains, preload)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Prevent MIME-type sniffing
        X-Content-Type-Options "nosniff"

        # Block framing from other origins
        X-Frame-Options "SAMEORIGIN"

        # XSS protection (legacy browsers)
        X-XSS-Protection "1; mode=block"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Permissions policy — restrict sensitive APIs
        Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"

        # Content-Security-Policy — tighten as needed
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://{$DOMAIN}; frame-ancestors 'self';"

        # Remove server identification headers
        -Server
        -X-Powered-By
    }

    # ── WebSocket upgrade proxy → backend ─────────────────────
    @websocket {
        path /ws/*
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── API routes → FastAPI backend ──────────────────────────
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Timeouts
            transport http {
                dial_timeout 10s
                response_header_timeout 120s
                read_timeout 120s
                write_timeout 120s
            }

            # Health check on upstream
            health_uri /api/health
            health_interval 30s
            health_timeout 5s
            health_status 200
        }
    }

    # ── Everything else → Next.js frontend ───────────────────
    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            transport http {
                dial_timeout 10s
                response_header_timeout 60s
            }
        }
    }
}
